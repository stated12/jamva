# ---- Required ----
NEXT_PUBLIC_SITE_URL=https://your-domain.in
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (add when your account is approved; use rzp_test_ keys first) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---- Business details shown on legal/contact pages (Razorpay checks these) ----
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# ---- Notifications (all optional; each channel switches on when its keys exist) ----
# Web push: generate keys with  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@jamva.in
# Email (any SMTP: Brevo, Zoho, Gmail app password, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jamva <orders@your-domain.in>
# WhatsApp Cloud API (Meta). Template body must have two variables: {{1}} order code, {{2}} amount
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NEW_ORDER=jamva_new_order
WHATSAPP_TEMPLATE_LANG=en
